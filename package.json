{
  "name": "xvault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A lightweight and secure two-factor authentication (2FA) token manager.",
  "scripts": {
    "dev": "vite",
    "server": "cargo run --manifest-path backend/Cargo.toml",
    "dev:all": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_click_events_have_key_events:ignore,a11y_no_static_element_interactions:ignore\"",
    "preview": "vite preview",
    "backend:build": "cargo build --release --manifest-path backend/Cargo.toml",
    "backend:test": "cargo test --manifest-path backend/Cargo.toml",
    "start": "./backend/target/release/xvault",
    "prod": "npm run build && npm run backend:build"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "jsqr": "^1.4.0",
    "material-symbols": "^0.46.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "concurrently": "^10.0.5",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  }
}
